{
  "name": "hearthwood",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "boundaries": "node tools/check-boundaries.ts",
    "check": "npm run lint && npm run typecheck && npm run boundaries",
    "test": "vitest run",
    "e2e": "playwright test",
    "audio": "node tools/audio-render.ts",
    "soak": "node tools/soak.ts",
    "shots": "node tools/shots.ts",
    "lab:build": "node tools/lab-build.ts"
  },
  "dependencies": {
    "postprocessing": "6.39.5",
    "three": "0.186.0",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
